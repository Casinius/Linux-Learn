#let CJK_set(doc)=[
  #set text(font: "Noto Sans CJK SC", lang: "zh", region: "cn")
  #doc
]

#let centerize(doc)=[
  #align(center)[
    #doc
  ]
]
#let formal_text(doc)=[
  #set text(size: 13pt)
  #doc
]
#let small_formal_text(doc)=[
  #set text(size:12pt)
  #doc
]
#let H1(doc)=[
  #set text(size:19pt)
  *#doc*
]

#let H2(doc)=[
  #set text(size: 18pt)
  *#doc*
]

#let H3(doc)=[
  #set text(size: 17pt)
  *#doc*
]
#let H4(doc)=[
  #set text(size: 16pt)
  *#doc*
]

#let H5(doc)=[
  #set text(size: 15pt)
  *#doc*
]
#let H6(doc)=[
  #set text(size: 14pt)
  *#doc*
]